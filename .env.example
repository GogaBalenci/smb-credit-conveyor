# Скопируйте в .env и при необходимости измените. Все переменные необязательны для локального запуска.

# Секрет подписи JWT (минимум 32 байта). Обязателен при DEMO_MODE=false.
JWT_SECRET=change-me-local-demo-secret-at-least-32-bytes
# Демо-режим: показывает демо-учётки на экране входа и код подписания в интерфейсе.
DEMO_MODE=true
# Пауза между шагами конвейера — чтобы на демо было видно движение заявки.
PIPELINE_STEP_DELAY=2s
# Симулятор внешних источников: задержка ответа и доля ответов 503.
MOCK_LATENCY_MS=700
MOCK_FAILURE_RATE=0
# Только для сервера (docker-compose.prod.yml): домен для HTTPS или :80 для доступа по IP.
# SITE_ADDRESS=alfa.example.ru
