{
  "info": {
    "name": "Кредитный конвейер — API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Сквозной сценарий через REST. Выполняйте запросы по порядку (Runner). Переменная base — адрес API (по умолчанию http://localhost:8080). Между «Отправить» и «Карточка заявки» подождите 5–10 секунд — конвейер работает асинхронно."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "app_id",
      "value": ""
    },
    {
      "key": "sign_code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Служебные",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/healthz",
              "host": [
                "{{base}}"
              ],
              "path": [
                "healthz"
              ]
            }
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/readyz",
              "host": [
                "{{base}}"
              ],
              "path": [
                "readyz"
              ]
            }
          }
        },
        {
          "name": "Справочники и демо-учётки",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/meta",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "meta"
              ]
            }
          }
        },
        {
          "name": "Метрики Prometheus",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/metrics",
              "host": [
                "{{base}}"
              ],
              "path": [
                "metrics"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Клиент: одобрение → выдача",
      "item": [
        {
          "name": "Вход (approve@demo.ru)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"approve@demo.ru\",\n  \"password\": \"demo12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Профиль",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/auth/me",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Подбор продукта по цели",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/recommendations",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "recommendations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"working_capital\",\n  \"amount\": 2000000,\n  \"term_months\": 24,\n  \"has_collateral\": false,\n  \"urgent\": true\n}"
            }
          }
        },
        {
          "name": "Автозаполнение из ФНС и БКИ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/prefill",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "prefill"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('fin', JSON.stringify(pm.response.json().financials));"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать черновик (идемпотентно)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_code\": \"EXPRESS\",\n  \"purpose\": \"working_capital\",\n  \"purpose_comment\": \"Закупка оборудования для офиса\",\n  \"amount\": 2000000,\n  \"term_months\": 24,\n  \"financials\": {\n    \"annual_revenue\": 64000000,\n    \"prev_annual_revenue\": 52000000,\n    \"annual_net_profit\": 8100000,\n    \"monthly_obligations\": 120000,\n    \"collateral_value\": 0,\n    \"employees\": 38\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('app_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Отправить в конвейер",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}/submit",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}",
                "submit"
              ]
            }
          }
        },
        {
          "name": "Карточка заявки (статус, проверки, журнал)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}"
              ]
            },
            "description": "Повторите через несколько секунд, если статус ещё SUBMITTED/CHECKING/SCORING."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const a = pm.response.json().application;",
                  "pm.test('решение принято', () => pm.expect(['APPROVED','COUNTER_OFFER']).to.include(a.status));"
                ]
              }
            }
          ]
        },
        {
          "name": "Запросить код подписания",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}/sign-code",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}",
                "sign-code"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sign_code', pm.response.json().demo_code);"
                ]
              }
            }
          ]
        },
        {
          "name": "Подписать",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}/sign",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}",
                "sign"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{sign_code}}\"\n}"
            }
          }
        },
        {
          "name": "Карточка после выдачи",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}"
              ]
            }
          }
        },
        {
          "name": "Персональная лента",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/feed",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "feed"
              ]
            }
          }
        },
        {
          "name": "Мои заявки",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Андеррайтер",
      "item": [
        {
          "name": "Вход (underwriter@demo.ru)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"underwriter@demo.ru\",\n  \"password\": \"demo12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Очередь на ручное рассмотрение",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications?status=MANUAL_REVIEW",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "MANUAL_REVIEW"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const it = pm.response.json().items;",
                  "if (it.length) pm.collectionVariables.set('app_id', it[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Взять в работу",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}/take",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}",
                "take"
              ]
            }
          }
        },
        {
          "name": "Контрпредложение",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}/decision",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\",\n  \"amount\": 800000,\n  \"term_months\": 24,\n  \"comment\": \"Одобрено с учётом оборотов по выписке\"\n}"
            }
          }
        },
        {
          "name": "Запросить документы",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}/decision",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"request_info\",\n  \"documents\": [\n    \"financial_statements\"\n  ],\n  \"comment\": \"Нужна отчётность за год\"\n}"
            }
          }
        },
        {
          "name": "Отказ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications/{{app_id}}/decision",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications",
                "{{app_id}}",
                "decision"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reject\",\n  \"comment\": \"Недостаточный денежный поток\"\n}"
            }
          }
        },
        {
          "name": "Сводка по конвейеру",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/stats",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "stats"
              ]
            }
          }
        },
        {
          "name": "Включить сбои источников (30%)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/admin/faults",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "faults"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failure_rate\": 0.3\n}"
            }
          }
        },
        {
          "name": "Выключить сбои",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/admin/faults",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "faults"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failure_rate\": 0\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Негативные проверки",
      "item": [
        {
          "name": "Без токена → 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Неверный пароль → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"approve@demo.ru\",\n  \"password\": \"wrong\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Сумма вне лимитов → 422 с полями",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/applications",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "applications"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_code\": \"EXPRESS\",\n  \"amount\": 999\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Регистрация с неверным ИНН → 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/v1/auth/register",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"x@y.ru\",\n  \"password\": \"secret123\",\n  \"full_name\": \"Тест\",\n  \"inn\": \"1234567890\"\n}"
            }
          }
        }
      ]
    }
  ]
}